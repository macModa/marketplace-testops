# Marketplace TestOps Frontend — Environment Variables

# Quality Guardian Cloud API base URL.
# Set this to the deployed Render service URL.
# In Vite, all client-exposed variables must start with VITE_.
# If unset, the client defaults to https://qualityguardian.onrender.com
VITE_API_BASE_URL=https://qualityguardian.onrender.com

# Vercel Dashboard setup (Production + Preview + Development):
# Key:   VITE_API_BASE_URL
# Value: https://qualityguardian.onrender.com
#
# For local development, copy this file to .env.local and adjust if needed.
# NEVER commit .env.local or any file containing real credentials.
